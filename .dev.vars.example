# Required for local authentication. Replace both values before starting Wrangler.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASS=replace-with-a-local-admin-password

# Configuration authority migration: kv (default), shadow, or d1.
# Initialize D1 Schema v2 before switching to d1.
CONFIG_AUTHORITY_MODE=kv

# Optional: TMDB aggregation for nodes with 启用 TMDB 聚合. Account-settings
# credentials take precedence as a group: if either credential is set there, both
# env vars below are ignored. Otherwise these env vars are the fallback.
# TMDB_API_READ_TOKEN=replace-with-a-tmdb-v4-read-token
# TMDB_API_KEY=replace-with-a-tmdb-v3-api-key
# TMDB_LANGUAGE=zh-CN
